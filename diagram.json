  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -120, "left": -150, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot2", "top": 150, "left": -150, "attrs": {} },
    { "type": "wokwi-led", "id": "led_status", "top": 0, "left": 180, "attrs": { "color": "blue" } }
