    [ "esp:3V3", "pot1:VCC", "red", [ "v0" ] ],
    [ "esp:D34", "pot1:SIG", "orange", [ "v0" ] ],
    [ "esp:GND.1", "pot2:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot2:VCC", "red", [ "v0" ] ],
    [ "esp:D35", "pot2:SIG", "purple", [ "v0" ] ],
    [ "esp:D2", "led_status:A", "blue", [ "v0" ] ],
    [ "esp:GND.2", "led_status:C", "black", [ "v0" ] ]
